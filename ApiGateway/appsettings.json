{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "Ordering-route": {
        "ClusterId": "Ordering-Cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": {
          "Path": "/Order-api/{**catch-all}" // //catch al mean take all catch and append into destination ex :     https:10.1.20/Order-api/getOrder/1  is translate into destination :  https://localhost:7264/OrderStock/getOrder/1
        },
        "Transforms": [

          { "PathPattern": "{**catch-all}" } //this reponsbale for transfor cath all to spicific destination

          /* {
            "QueryValueParameter": "query",
            "Append": "plugin"
          }*/

        ]
      },
      "Identity-api": {
        "ClusterId": "Identity-api",
        "Match": {
          "Path": "/Identity-api/{**catch-all}"
        },
        "Transforms": [

          { "PathPattern": "{**catch-all}" }

        ]
      }
    },
    "Clusters": {
      "Ordering-Cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost/OrderingSystemDDD/api/"
          }
          //you can add other destinations here 
          //You can use load balancing by add more than one destinations 

        }
      },

      "Identity-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost/IdenityApi/api/"
          }
          //you can add other destinations here 
          //You can use load balancing by add more than one destinations 

        }
      }

    }
  },
  "SignalRUrlHC": "http://localhost:5222/hc",
  "OrderingUrlHC": "http://localhost:5224/hc",
  "WebSocketUrlHC": "http://localhost:5221/hc",
  "IdentityUrlHC": "http://localhost:5223/hc",
  "Jwt": {
    "SecretKey": "ZakariaYahyazAKARIAZAZAZAZAZAZAZAAAAAAAAAAAAAAAAAAZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZS",
    "Issuer": "https://localhost:7198/",
    "Audience": "https://localhost:7122/",
    "ExpiresDayes": "7"
  },
  "Identity": {
    "apiUrl": "https://localhost:7198/api/"
  },
  "AllowedHosts": "*"
}
